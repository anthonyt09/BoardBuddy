platform :ios, '16.0'
use_frameworks!

target 'BoardBuddy' do
  pod 'GoogleMLKit/PoseDetectionAccurate', '~> 8.0'

  # The unit tests link against the host app, so they only need ML Kit's
  # header/framework search paths — not a second copy of the frameworks.
  target 'BoardBuddyTests' do
    inherit! :search_paths
  end
end

# ML Kit's binaries carry a device-arm64 + simulator-x86_64 fat slice and no
# arm64-simulator slice, so CocoaPods marks the ML Kit pods and the aggregate
# targets EXCLUDED_ARCHS=arm64 for the simulator. It does NOT mark ML Kit's
# transitive dependencies (PromisesObjC, GTMSessionFetcher, GoogleUtilities,
# nanopb, ...), so on an Apple Silicon Mac those compile arm64 while
# everything else compiles x86_64, and linking dies with
# "missing required architecture x86_64 in ... .tbd".
#
# Forcing the exclusion onto every pod keeps the whole graph on x86_64 for
# the simulator. Device builds are untouched and stay arm64.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end
